include README.md pyproject.toml requirements.txt CHANGELOG.md
recursive-include src/video_keyframe *.py
recursive-include configs *.yaml
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
prune backup
prune outputs
prune checkpoints
prune .venv
prune .uv-cache
prune delivery
global-exclude __pycache__ *.py[cod]
